#!/usr/bin/env bash
# Blocks `git push` unless the whole test suite passes.
# Enable once per clone with: git config core.hooksPath .githooks
# Bypass in an emergency with: git push --no-verify
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "pre-push: running cargo test..."
if ! cargo test --all-targets --quiet; then
    echo
    echo "pre-push: tests failed, push aborted. Fix the failing tests and push again."
    exit 1
fi
echo "pre-push: all tests passed."
